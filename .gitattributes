# Normalise line endings: LF in the repository.  Keil/CubeMX/CubeIDE and
# armcc all accept LF sources (verified by building from a fresh checkout).

* text=auto eol=lf

# ---------------------------------------------------------------------------
# Windows tooling that is picky about CRLF
# ---------------------------------------------------------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ---------------------------------------------------------------------------
# Binary (never touch)
# ---------------------------------------------------------------------------
*.pack     binary
*.pdf      binary
*.png      binary
*.jpg      binary
*.gif      binary
*.hex      binary
*.bin      binary
*.axf      binary

# ---------------------------------------------------------------------------
# Diff / linguist
# ---------------------------------------------------------------------------
Drivers/CMSIS/**        linguist-vendored
Drivers/STM32G4xx_HAL_Driver/**  linguist-vendored
MDK-ARM/*.uvprojx       linguist-detectable=false
MDK-ARM/*.uvoptx        linguist-detectable=false
